#!/usr/bin/env bash
# install-githooks-shim: v3
# Generated by `mise run install-githooks`; do not edit by hand.
# Re-run the task to regenerate. Repo-specific checks belong in the
# <hook>.local file this dispatches to.
set -euo pipefail

hook_name="$(basename "$0")"

# Ask Git where the global hooks live. This has to be the --global lookup:
# this repo records its own core.hooksPath=.githooks, which shadows the
# global setting for every ordinary config read. The fallback is
# $HOME-based, not $XDG_CONFIG_HOME-based, because taskferry redirects
# XDG_CONFIG_HOME for sandboxed workers (src/executor.js) and the global
# hooks do not live under the per-task directory that produces.
global_hooks_dir="$(git config --global --get core.hooksPath 2>/dev/null || true)"
if [ -z "$global_hooks_dir" ]; then
  global_hooks_dir="$HOME/.config/git/hooks"
elif [ "${global_hooks_dir#\~/}" != "$global_hooks_dir" ]; then
  global_hooks_dir="$HOME/${global_hooks_dir#\~/}"
fi
global_hook="$global_hooks_dir/$hook_name"

# 1. Global gates (em dash, primary checkout, worktree budget, ...), when
#    dotfiles are applied. Skipped when a global hook is what invoked this
#    shim, so the two do not re-enter each other.
if [ -z "${GIT_HOOKS_CHAINED:-}" ] && [ -x "$global_hook" ]; then
  GIT_HOOKS_CHAINED=1 "$global_hook" "$@" || exit $?
fi

# 2. This repo's own checks, if it has any. The root is resolved only now,
#    after the global leg, so a repo with no local hook does no extra work
#    before the global hook runs.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$repo_root" ] || exit 0

# A `hooks/<hook>` symlink can resolve back to this file with no basename
# change to stop the recursion, and realpath may be unavailable to detect
# it. Depth is the backstop; three levels is already deeper than any
# sane chain of repo hooks.
depth="${TASKFERRY_HOOK_DEPTH:-0}"
if [ "$depth" -ge 3 ]; then
  echo "install-githooks-shim: $hook_name recursed $depth levels; refusing" >&2
  exit 0
fi
self_path="$(realpath "$0" 2>/dev/null || printf '%s' "$0")"

for candidate in "$repo_root/.githooks/$hook_name.local" "$repo_root/hooks/$hook_name"; do
  [ -f "$candidate" ] || continue
  # Skip only when the candidate provably is this shim. When realpath is
  # missing we cannot prove it, so run it under the depth guard rather than
  # silently skipping every repo-local hook.
  if command -v realpath >/dev/null 2>&1; then
    candidate_real="$(realpath "$candidate" 2>/dev/null || true)"
    [ -n "$candidate_real" ] && [ "$candidate_real" = "$self_path" ] && continue
  fi
  if [ -x "$candidate" ]; then
    exec env GIT_HOOKS_CHAINED=1 TASKFERRY_HOOK_DEPTH=$((depth + 1)) "$candidate" "$@"
  else
    exec env GIT_HOOKS_CHAINED=1 TASKFERRY_HOOK_DEPTH=$((depth + 1)) bash "$candidate" "$@"
  fi
done
