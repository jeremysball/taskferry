#!/bin/sh
# Taskferry pre-commit hook: worktree gate + syntax-check + lint + typecheck.
#
# 0. Worktree gate — require a dedicated worktree per branch. See
#    deterministic-guardrails reorientation, "What to build, in order" #3.
# 1. `node --check` parses every staged .js (catches malformed syntax before
#    it ever reaches a review or CI).
# 2. ESLint catches what parsing can't -- undefined vars (no-undef), unsafe
#    finally blocks, discarded caught errors, etc. Warnings inform; only
#    errors block the commit.
# 3. `tsc --noEmit` type-checks src/tasks.js and src/server.js (see
#    tsconfig.json) against their JSDoc annotations.
#
# Bypass lint/typecheck in a pinch with `git commit --no-verify`.
# Bypass the worktree gate (CI/fresh clone) with `TASKFERRY_ALLOW_PRIMARY=1`
# or `git config taskferry.allowPrimary true`.

# --- 0. worktree gate (before the early-exit, so docs-only commits are also gated) ---
if [ "${TASKFERRY_ALLOW_PRIMARY:-}" != "1" ] && [ "${TASKFERRY_ALLOW_PRIMARY:-}" != "true" ]; then
  allowPrimary="$(git config --bool taskferry.allowPrimary 2>/dev/null || echo false)"
  if [ "$allowPrimary" != "true" ]; then
    gitdir="$(git rev-parse --git-dir 2>/dev/null)"
    common="$(git rev-parse --git-common-dir 2>/dev/null)"
    if [ -n "$gitdir" ] && [ -n "$common" ] && [ "$gitdir" = "$common" ]; then
      echo "✗ commit blocked: this is the primary checkout, not a worktree."
      echo "  Taskferry requires a dedicated worktree per branch (see CONTRIBUTING.md / CLAUDE.md)."
      echo "  Create one with: git worktree add <path> -b <branch>"
      echo "  Bypass (CI/fresh clone): TASKFERRY_ALLOW_PRIMARY=1 git commit ..."
      echo "  Or: git config taskferry.allowPrimary true  (local only, not committed)"
      echo "  Or: git commit --no-verify  (bypasses all hooks)"
      exit 1
    fi
  fi
fi

# Staged, non-deleted .js files (newline-safe enough for this repo's paths).
files=$(git diff --cached --name-only --diff-filter=ACM -- '*.js')
# Do not early-exit before the gate above — but lint/typecheck still skip when no JS staged.
no_js=0
[ -z "$files" ] && no_js=1
if [ "$no_js" = "1" ]; then
  # Gate already passed; no JS to check.
  exit 0
fi

fail=0

# --- 1. parse check (validates the STAGED content) ---
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
repo="$(git rev-parse --show-toplevel)"
for f in $files; do
  blob="$tmp/$(printf '%s' "$f" | tr '/' '_')"
  git show ":$f" > "$blob" 2>/dev/null || continue
  if ! err="$(node --check "$blob" 2>&1)"; then
    echo "✗ $f — JavaScript parse error:"
    printf '%s\n' "$err" | sed "s#$blob#$f#g"
    fail=1
  fi
done

# --- 2. eslint / tsc (the complete staged tree, not working-tree files) ---
# Resolve eslint from this worktree or its primary (worktrees often share primary's node_modules).
eslint_root="$repo"
if [ ! -x "$repo/node_modules/.bin/eslint" ]; then
  common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"
  if [ -n "$common_dir" ]; then
    # common_dir is .git (primary, relative) or /path/to/.git (worktree, absolute)
    case "$common_dir" in
      .git) candidate="$repo" ;;
      */.git) candidate="$(dirname "$common_dir")" ;;
      *) candidate="" ;;
    esac
    if [ -n "$candidate" ] && [ -x "$candidate/node_modules/.bin/eslint" ]; then
      eslint_root="$candidate"
    fi
  fi
fi
if [ -x "$eslint_root/node_modules/.bin/eslint" ]; then
  mkdir -p "$tmp/tree"
  git checkout-index --all --prefix="$tmp/tree/"
  ln -s "$eslint_root/node_modules" "$tmp/tree/node_modules"
  if ! (
    cd "$tmp/tree" || exit 1
    ./node_modules/.bin/eslint . && ./node_modules/.bin/tsc --noEmit
  ); then
    fail=1
  fi
else
  echo "⚠ eslint and typescript are not installed — run 'npm install' to enable quality checks."
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "Commit blocked by pre-commit: fix the error(s) above."
  echo "(Run \`npm run check\` for the full repo; \`git commit --no-verify\` to bypass.)"
  exit 1
fi
