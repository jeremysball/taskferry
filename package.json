{
  "name": "taskferry",
  "version": "4.2.0",
  "description": "AXI CLI and local daemon for dispatching background pi/OpenCode tasks from any frontend harness",
  "license": "MIT",
  "author": "Jeremy Ball",
  "homepage": "https://github.com/jeremysball/taskferry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremysball/taskferry.git"
  },
  "bugs": {
    "url": "https://github.com/jeremysball/taskferry/issues"
  },
  "main": "src/cli.js",
  "exports": "./src/opencode-plugin.js",
  "bin": {
    "taskferry": "src/cli.js"
  },
  "files": [
    "src/*.js",
    "!src/*.test.js",
    "!src/*-test.js",
    "!src/*test-helpers.js",
    "!src/*test-support.js",
    "scripts/generate-skill.js",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "npm run test:unit",
    "test:unit": "env -u TASKFERRY_CHILD node --test \"src/**/*.test.js\"",
    "test:integration": "node src/smoke-test.js && node src/cancel-smoke-test.js && node src/poll-smoke-test.js",
    "skill:generate": "node scripts/generate-skill.js",
    "skill:check": "node scripts/generate-skill.js --check",
    "lint": "npm exec --no -- eslint .",
    "typecheck": "npm exec --no -- tsc --noEmit",
    "check": "git ls-files '*.js' | xargs -P4 -I{} node --check {} && npm run lint && npm run typecheck && npm run skill:check && npm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@toon-format/toon": "^2.3.0",
    "cli-table3": "^0.6.5",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.7.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "eslint-plugin-sonarjs": {
      "ts-api-utils": {
        "typescript": "6.0.3"
      }
    }
  }
}
